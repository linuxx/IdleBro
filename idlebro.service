[Unit]
Description=IdleBro adaptive background load

[Service]
Type=simple
ExecStart=/opt/idlebro/IdleBro
DynamicUser=yes
Nice=19
CPUSchedulingPolicy=idle
OOMScoreAdjust=1000
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
Restart=on-failure
RestartSec=5
TimeoutStopSec=5

[Install]
WantedBy=multi-user.target
